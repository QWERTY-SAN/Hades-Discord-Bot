# Required
DISCORD_TOKEN=your_discord_bot_token
GEMINI_API_KEY=your_gemini_api_key

# Gemini
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_THINKING_LEVEL=minimal

# Discord bot
BOT_PREFIX=h!
# false = normal conversation is allowed; true = enable the narrow specialist filter
STRICT_AETHER_TOPIC=false

# Conversation memory
MAX_HISTORY=16
MEMORY_TTL_SECONDS=21600
MAX_CONVERSATIONS=500

# Generation / limits
MAX_OUTPUT_TOKENS=768
MAX_INPUT_CHARS=6000
USER_COOLDOWN=2.0
MAX_CONCURRENT_REQUESTS=3
MAX_QUEUE_WAIT=20
REQUEST_TIMEOUT=45
MAX_RETRIES=3

# Maintenance
MEMORY_PRUNE_INTERVAL=900
COOLDOWN_PRUNE_INTERVAL=3600

# Presentation
# Keep downloaded GIF bytes in memory to reduce repeated downloads.
# Conservative upload/download safety limit: 8 MB.
# Per-GIF HTTP timeout.

# Render supplies PORT automatically.
# PORT=10000

# GIF URLs live in hades_bot/gifs.py; do not put them in .env.
