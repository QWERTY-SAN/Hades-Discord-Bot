# Required
DISCORD_TOKEN=your_discord_bot_token
GEMINI_API_KEY=your_gemini_api_key

# Gemini
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_THINKING_LEVEL=minimal

# Discord bot
BOT_PREFIX=h!
# false = ordinary conversation is allowed; true = also apply the narrow Aether-topic filter
STRICT_AETHER_TOPIC=false
# Hades may naturally use sparse emojis in her replies
EMOJIS_ENABLED=true

# Conversation memory
MAX_HISTORY=16
MEMORY_TTL_SECONDS=21600
MAX_CONVERSATIONS=500

# Generation / limits
MAX_OUTPUT_TOKENS=768
MAX_INPUT_CHARS=6000
USER_COOLDOWN=2.0
MAX_CONCURRENT_REQUESTS=3
MAX_QUEUE_WAIT=20
REQUEST_TIMEOUT=45
MAX_RETRIES=3

# Maintenance
MEMORY_PRUNE_INTERVAL=900
COOLDOWN_PRUNE_INTERVAL=3600

# GIF URLs are stored in hades_bot/gifs.py, not here.
# PORT is normally supplied automatically by Render.
